# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local virtual environment
.venv/

# Local Flask database, uploaded documents, and instance secrets
instance/*
!instance/.gitkeep

# Environment files and secrets (keep the example template shareable)
.env
.env.*
!.env.example

# Local logs and coverage output
*.log
.coverage
htmlcov/
